# Copy to .env and fill in. Never commit the real .env file.

# Neon (or any) Postgres connection string
DATABASE_URL=

# Random long string used to sign login sessions (JWTs). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Random 32+ character string used to encrypt custodial private keys at
# rest. Generate the same way as JWT_SECRET, using a DIFFERENT value.
ENCRYPTION_KEY=

# Sepolia RPC endpoint (same one used in backend/ethereum/.env)
SEPOLIA_RPC_URL=

# The platform's own admin wallet on each chain — this is the `owner` of
# both ClassChainToken contracts (addMember / mint). Fund these with a
# little test ETH/TRX so gas never runs out. Can reuse the deployer keys
# from backend/ethereum/.env and backend/tron/.env, or use fresh ones.
ETH_ADMIN_PRIVATE_KEY=
TRON_ADMIN_PRIVATE_KEY=

# Deployed ClassChainToken contract addresses (printed by the deploy
# scripts in backend/ethereum and backend/tron).
CLASSCHAIN_ETH_ADDRESS=
CLASSCHAIN_TRON_ADDRESS=

# First teacher account, created once by `npm run seed`.
TEACHER_USERNAME=
TEACHER_PASSWORD=

# --- Training USDT TRON treasury (TRC-10 token 1007344) -------------------
# Backend-controlled sender for the TRON side of the Training USDT
# dashboard. This key must own the TUSDT balance (token 1007344) and hold
# some Nile TRX for gas. When unset, TRON_ADMIN_PRIVATE_KEY above is used
# (the current key owns token 1007344). Never expose this key to the
# frontend; it is used only inside the backend process.
TRON_TREASURY_PRIVATE_KEY=

# Nile-only allowlist (default). Do not point this at any other network.
TRON_NILE_HOST=https://nile.trongrid.io

# Training TUSDT TRC-10 token id.
TRON_TOKEN_ID=1007344

# Optional shared secret that /api/tron/send-trx and /api/tron/send-trc10
# require via the `x-api-key` header. Leave empty for open local training.
TRAINING_API_KEY=

PORT=4000

# Comma-separated list of frontend origins allowed to call this API
# (localhost is always allowed automatically). Example:
# ALLOWED_ORIGINS=https://training-ui-for-the-sepolia-training-usdt-usdt.onrender.com
ALLOWED_ORIGINS=
